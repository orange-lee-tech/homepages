{
  "name": "homepages-i18n-tools",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/content-pipeline.mjs",
    "build:check": "node scripts/content-pipeline.mjs --check",
    "i18n": "node scripts/i18n-sync.mjs",
    "i18n:traditional": "node scripts/i18n-sync.mjs --traditional-only",
    "new-post": "node scripts/new-post.mjs",
    "check": "node scripts/validate-content.mjs",
    "ci": "npm run build:check && npm run check"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "opencc-js": "^1.0.5"
  }
}
